# Stage 1: Build phase
FROM golang:1.25-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy dependency files for layer caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source code
COPY . .

# Build the main API application
RUN CGO_ENABLED=0 GOOS=linux go build -v -o api-main cmd/api/main.go

# Stage 2: Runtime phase
FROM alpine:latest

# Install runtime dependencies (e.g. certificates)
RUN apk add --no-cache ca-certificates

WORKDIR /app

# Copy binary from the builder stage
COPY --from=builder /app/api-main .

# Expose the API port
EXPOSE 8080

CMD ["./api-main"]
